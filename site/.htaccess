# TAPP website (Apache / cPanel). Upload the contents of site/ to the domain's public_html.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
RewriteEngine On
# Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# Clean URLs: /privacy -> privacy.html, and /privacy.html -> /privacy
RewriteCond %{THE_REQUEST} \s/([^.\s?]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
# Keep the build tooling private
RewriteRule ^(src|tools)(/|$) - [F,L]
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(png|jpg|svg|ttf|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "^config\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
