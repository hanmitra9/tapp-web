# Used by the Dockerfile (nginx image substitutes ${PORT} at start). Same rules as deploy/nginx.conf.
server {
  listen ${PORT};
  root /usr/share/nginx/html;
  index index.html;
  absolute_redirect off;
  server_tokens off;
  include /etc/nginx/snippets/security-headers.conf;

  location ~ ^/(src|tools)(/|$) { return 404; }
  location ~ /\. { return 404; }
  location /admin/ { try_files $uri $uri/ /admin/index.html; include /etc/nginx/snippets/security-headers.conf; add_header X-Robots-Tag "noindex, nofollow" always; }
  # Landing pages with clean URLs (/privacy, /campaigns); anything else is a signed-in page of the web app.
  location / { try_files $uri $uri.html $uri/ /app.html; add_header Cache-Control "no-cache"; include /etc/nginx/snippets/security-headers.conf; }

  location ~ ^/(index|app)\.html$ { add_header Cache-Control "no-cache"; include /etc/nginx/snippets/security-headers.conf; }
  location = /assets/config.js { add_header Cache-Control "no-cache"; include /etc/nginx/snippets/security-headers.conf; }
  location ~ ^/(assets|_expo|fonts)/ { add_header Cache-Control "public, max-age=604800"; include /etc/nginx/snippets/security-headers.conf; }
  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;
}
